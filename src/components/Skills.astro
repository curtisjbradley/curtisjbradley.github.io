---
import { getTagClasses } from '../lib/tagColors';

const skillGroups = [
  {
    category: 'Languages',
    skills: ['Python', 'TypeScript', 'Java', 'SQL', 'R', 'C'],
  },
  {
    category: 'Web & Backend',
    skills: ['React', 'PostgreSQL', 'MongoDB', 'REST APIs', 'Express'],
  },
  {
    category: 'Data & ML',
    skills: ['Pandas', 'Scikit-learn', 'Survival Analysis', 'Linear Discriminant Analysis', 'Statistical Modeling'],
  },
  {
    category: 'Developer Tools',
    skills: ['Git', 'GitHub Actions', 'Jest', 'Cypress', 'AWS / EC2', 'Quarto', 'LaTeX'],
  },
];
---

<section id="skills" class="py-24">
  <div class="max-w-5xl mx-auto px-6">
    <h2 class="text-3xl font-bold text-white mb-2">Technical Skills</h2>
    <div class="w-12 h-1 bg-sky-400 mb-12 rounded"></div>

    <div class="grid sm:grid-cols-2 gap-8">
      {skillGroups.map((group) => (
        <div class="bg-slate-800/50 border border-slate-700 rounded-xl p-6 hover:border-sky-400/50 transition-colors">
          <h3 class="text-sky-400 font-semibold text-sm uppercase tracking-widest mb-4">
            {group.category}
          </h3>
          <div class="flex flex-wrap gap-2">
            {group.skills.map((skill) => (
              <span class:list={['text-xs font-mono px-2.5 py-1 rounded-full border', getTagClasses(skill)]}>
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
