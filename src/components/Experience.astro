---
const experiences = [
  {
    role: 'IT Helpdesk Assistant',
    org: 'City of San Luis Obispo, Information Technology Department',
    period: 'Nov 2023 – Feb 2026',
    bullets: [
      'Handled 2,000+ support tickets across networking, hardware, software, and account access - learned fast how to diagnose problems under pressure.',
      'Wrote PowerShell and Python scripts to automate repetitive tasks, which freed up time for the team to focus on harder problems.',
      'Kept a running knowledge base of common issues so new techs could get up to speed without reinventing the wheel.',
    ],
  },
  {
    role: 'Undergraduate Researcher',
    org: 'Cuesta College',
    period: 'Aug 2023 – Mar 2025',
    bullets: [
      'Worked on a formal proof connecting harmonic-number series to Riemann zeta functions, using Python for symbolic verification.',
      'Prepared the research for submission to the College Mathematics Journal and presented at the National Conference of Undergraduate Research.',
    ],
  },
  {
    role: 'Academic Advisor - Mock Trial',
    org: 'San Luis Coastal Unified School District',
    period: 'Jun 2022 – Present',
    bullets: [
      'Coach a high school mock trial team competing at the national level, focusing on trial advocacy, case theory, and courtroom performance.',
      'Track scores across practice rounds in Excel, look for trends, and use that data to focus coaching where it matters most.',
    ],
  },
];
---

<section id="experience" class="py-24">
  <div class="max-w-5xl mx-auto px-6">
    <h2 class="text-3xl font-bold text-white mb-2">Experience</h2>
    <div class="w-12 h-1 bg-sky-400 mb-12 rounded"></div>

    <div class="relative border-l border-slate-700 ml-3 space-y-10">
      {experiences.map((exp) => (
        <div class="pl-8 relative">
          <!-- Timeline dot -->
          <span class="absolute -left-[7px] top-1.5 w-3.5 h-3.5 rounded-full bg-sky-400 border-2 border-[#0f172a]"></span>

          <div class="mb-1 flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <h3 class="text-white font-bold text-lg">{exp.role}</h3>
            <span class="text-slate-500 text-sm">·</span>
            <span class="text-sky-400 text-sm">{exp.org}</span>
          </div>
          <p class="text-slate-500 text-xs font-mono mb-3">{exp.period}</p>

          <ul class="space-y-2">
            {exp.bullets.map((b) => (
              <li class="flex gap-2 text-slate-400 text-sm leading-relaxed">
                <span class="text-sky-400 shrink-0 mt-0.5">▸</span>
                <span>{b}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
